<?php
/** @var \Illuminate\Support\Collection<int,object> $articles */
/** @var array<string,array{title:string,description:string,group:string}> $categories */
/** @var array<string,string> $audiences */
/** @var int $missingDefaults */
/** @var \Fisharebest\Webtrees\Tree $tree */
/** @var array<string,string> $treeNames */
/** @var string $moduleName */
/** @var array<string,string> $moduleRequirements */
/** @var array<string,bool> $moduleStatus */
/** @var array{yes:int,no:int} $feedbackTotals */
/** @var array{enabled:bool,visitors:bool,members:bool,individual:bool,family:bool,forms:bool,new_tab:bool} $contextualSettings */
$requirementsFor = static function (object $article): array {
    $raw = trim((string) ($article->requires_modules ?? ''));
    return $raw === '' ? [] : array_values(array_filter(array_map('trim', explode(',', $raw))));
};
